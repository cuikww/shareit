package core.transfer;

import core.network.ConnectionManager;
import core.utils.FileUtils;
import core.utils.Protocol;

import java.io.*;
import java.net.Socket;
import java.util.Arrays;

/**
 * SenderTask — reliable sender that supports resume and optional automatic reconnect/retry.
 */
public class SenderTask extends TransferTask {

    private final File file;
    private final String transferId;
    private final TransferManager.TransferListener listener;
    private final String username;

    // optional reconnect support
    private final ConnectionManager connectionManager; // may be null
    private final String targetIp; // null if no reconnect supported
    private final int maxRetries; // 0 means no automatic reconnect
    private final int baseRetryDelayMs = 2000;

    // progress
    private long totalBytes;
    private long bytesTransferred = 0;
    private String remotePeerName = "Unknown";

    // Legacy constructor (no reconnect)
    public SenderTask(File file, Socket socket, String transferId, TransferManager.TransferListener listener, String username) {
        this(file, socket, transferId, listener, username, null, null, 0);
    }

    // New constructor with optional reconnect retry parameters
    public SenderTask(File file, Socket socket, String transferId, TransferManager.TransferListener listener, String username,
                      ConnectionManager connectionManager, String targetIp, int maxRetries) {
        super(socket);
        this.file = file;
        this.transferId = transferId;
        this.listener = listener;
        this.username = username;
        this.connectionManager = connectionManager;
        this.targetIp = targetIp;
        this.maxRetries = Math.max(0, maxRetries);
    }

    public void setRemotePeerName(String name) { this.remotePeerName = name; }

    @Override
    public void run() {
        int attempt = 0;

        while (true) {
            InputStream in = null;
            OutputStream out = null;
            FileInputStream fis = null;

            try {
                attempt++;

                in = socket.getInputStream();
                out = socket.getOutputStream();

                try { socket.setSoTimeout(30_000); } catch (Exception ignored) {}

                log("Starting file transfer: " + file.getName() + " -> " + remotePeerName + " (attempt=" + attempt + ")");

                totalBytes = file.length();

                // Step 1: handshake
                Protocol.HandshakeMessage hs = new Protocol.HandshakeMessage(username, "1.0");
                Protocol.writeMessage(out, new Protocol.Message(Protocol.OP_HANDSHAKE, hs.toBytes()));

                Protocol.Message resp = Protocol.readMessage(in);
                if (resp.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after HANDSHAKE");

                // Step 2: send file info
                String md5 = FileUtils.getMD5(file);
                Protocol.FileInfoMessage fi = new Protocol.FileInfoMessage(file.getName(), totalBytes, md5);
                Protocol.writeMessage(out, new Protocol.Message(Protocol.OP_FILE_INFO, fi.toBytes()));

                resp = Protocol.readMessage(in);
                if (resp.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after FILE_INFO");

                long resumeOffset = 0;
                try { resumeOffset = Protocol.AckMessage.fromBytes(resp.payload).bytesReceived; } catch (Exception ignored) {}

                log("Receiver reports bytesReceived=" + resumeOffset);

                // Step 3: open file and skip to resume offset
                fis = new FileInputStream(file);
                if (resumeOffset > 0) {
                    long skipped = skipFully(fis, resumeOffset);
                    if (skipped != resumeOffset) throw new IOException("Unable to skip to resume offset: " + resumeOffset);
                    bytesTransferred = resumeOffset;
                    notifyProgress();
                } else {
                    bytesTransferred = 0;
                    notifyProgress();
                }

                // Step 4: stream data
                byte[] buf = new byte[Protocol.BUFFER_SIZE];
                int r;
                while ((r = fis.read(buf)) != -1) {
                    checkPaused(); checkCancelled();
                    byte[] chunk = Arrays.copyOf(buf, r);
                    Protocol.writeMessage(out, new Protocol.Message(Protocol.OP_DATA, chunk));
                    bytesTransferred += r;
                    notifyProgress();
                }

                // Step 5: complete
                Protocol.writeMessage(out, new Protocol.Message(Protocol.OP_COMPLETE, transferId.getBytes()));

                resp = Protocol.readMessage(in);
                if (resp.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after COMPLETE, got " + Protocol.getOperationName(resp.operation));

                log("Transfer completed: " + transferId);
                if (listener != null) listener.onTransferCompleted(transferId);
                return; // success

            } catch (InterruptedException ie) {
                log("Transfer interrupted: " + ie.getMessage());
                if (listener != null) listener.onTransferFailed(transferId, "Interrupted");
                return;

            } catch (Exception ex) {
                log("Transfer error on attempt " + attempt + ": " + ex.getMessage());
                ex.printStackTrace();

                // if reconnect is not configured or we've exhausted retries -> fail
                if (connectionManager == null || targetIp == null || attempt >= Math.max(1, maxRetries)) {
                    // try to notify remote
                    try { if (out != null) {
                        Protocol.ErrorMessage err = new Protocol.ErrorMessage(Protocol.ErrorCode.UNKNOWN_ERROR, ex.getMessage());
                        Protocol.writeMessage(out, new Protocol.Message(Protocol.OP_ERROR, err.toBytes()));
                    }} catch (Exception ignored) {}

                    if (listener != null) listener.onTransferFailed(transferId, ex.getMessage());
                    return;
                }

                // otherwise attempt reconnect + resume
                log("Attempting reconnect+resume (attempt " + attempt + ")");

                // close resources and backoff
                try { if (fis != null) { fis.close(); fis = null; } } catch (Exception ignored) {}
                try { if (socket != null && !socket.isClosed()) socket.close(); } catch (Exception ignored) {}

                long backoff = baseRetryDelayMs * (1L << Math.max(0, attempt-1));
                try { Thread.sleep(backoff); } catch (InterruptedException ie) { if (listener != null) listener.onTransferFailed(transferId, "Interrupted during backoff"); return; }

                try {
                    Socket newSock = connectionManager.connectTo(targetIp);
                    this.socket = newSock; // will loop and attempt again
                    log("Reconnected, will resume");
                    continue;
                } catch (Exception connEx) {
                    log("Reconnect failed: " + connEx.getMessage());
                    if (attempt >= maxRetries) {
                        if (listener != null) listener.onTransferFailed(transferId, "Reconnect failed: " + connEx.getMessage());
                        return;
                    }
                    // else, allow next loop iteration
                    continue;
                }

            } finally {
                try { if (fis != null) fis.close(); } catch (IOException ignored) {}
            }
        }
    }

    private long skipFully(InputStream in, long toSkip) throws IOException {
        long remaining = toSkip;
        while (remaining > 0) {
            long s = in.skip(remaining);
            if (s <= 0) {
                int b = in.read();
                if (b == -1) return toSkip - remaining;
                s = 1;
            }
            remaining -= s;
        }
        return toSkip;
    }

    private void notifyProgress() {
        if (listener != null) listener.onTransferProgress(transferId, bytesTransferred, totalBytes);
    }

    private void log(String msg) { System.out.println("[SenderTask] " + msg); }
}
package core.transfer;

import core.transfer.TransferManager.TransferListener;
import core.utils.FileUtils;
import core.utils.Protocol;
import core.utils.Protocol.*;

import core.network.ConnectionManager;

import java.io.*;
import java.net.Socket;
import java.util.Arrays;

/**
 * Task untuk mengirim file via TCP socket dengan Protocol.java
 * Supports resume and (optional) automatic reconnect/retry using ConnectionManager
 */
public class SenderTask extends TransferTask {

    private final File file;
    private final String transferId;
    private final TransferListener listener;
    private final String username;

    // Retry behaviour
    private final ConnectionManager connectionManager; // optional, used for reconnect
    private final String targetIp; // target ip used to reconnect
    private final int maxRetries;
    private final int baseRetryDelayMs = 2000; // 2s

    // Progress tracking
    private long totalBytes;
    private long bytesTransferred = 0;
    private String remotePeerName = "Unknown";

    // Legacy constructor (no auto-retry support)
    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username) {
        this(file, socket, transferId, listener, username, null, null, 0);
    }

    // New constructor with retry support via ConnectionManager
    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username,
                      ConnectionManager connectionManager, String targetIp, int maxRetries) {
        super(socket);
        this.file = file;
        this.transferId = transferId;
        this.listener = listener;
        this.username = username;
        this.connectionManager = connectionManager;
        this.targetIp = targetIp;
        this.maxRetries = Math.max(0, maxRetries);
    }

    public void setRemotePeerName(String name) { this.remotePeerName = name; }

    @Override
    public void run() {
        int attempt = 0;

        while (true) {
            InputStream in = null;
            OutputStream out = null;
            FileInputStream fileIn = null;

            try {
                attempt++;
                in = socket.getInputStream();
                out = socket.getOutputStream();

                try { socket.setSoTimeout(30_000); } catch (Exception ignored) {}

                log("Starting file transfer: " + file.getName() + " to " + remotePeerName);
                totalBytes = file.length();

                // handshake
                log("Sending HANDSHAKE...");
                HandshakeMessage handshake = new HandshakeMessage(username, "1.0");
                Message msg = new Message(Protocol.OP_HANDSHAKE, handshake.toBytes());
                Protocol.writeMessage(out, msg);

                // ACK
                Message ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after HANDSHAKE");
                log("Received ACK for HANDSHAKE");

                // file info
                String md5 = FileUtils.getMD5(file);
                FileInfoMessage fileInfo = new FileInfoMessage(file.getName(), totalBytes, md5);
                msg = new Message(Protocol.OP_FILE_INFO, fileInfo.toBytes());
                Protocol.writeMessage(out, msg);

                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after FILE_INFO");
                log("Received ACK for FILE_INFO");

                long resumeOffset = 0;
                try { resumeOffset = Protocol.AckMessage.fromBytes(ackMsg.payload).bytesReceived; } catch (Exception ignored) {}

                // send data
                fileIn = new FileInputStream(file);
                if (resumeOffset > 0) {
                    long skipped = skipFully(fileIn, resumeOffset);
                    if (skipped != resumeOffset) throw new IOException("Unable to skip to resume offset: " + resumeOffset);
                    bytesTransferred = resumeOffset;
                    notifyProgress();
                }

                byte[] buffer = new byte[Protocol.BUFFER_SIZE];
                int bytesRead;
                log("Sending file data...");
                while ((bytesRead = fileIn.read(buffer)) != -1) {
                    checkPaused(); checkCancelled();
                    byte[] chunk = Arrays.copyOf(buffer, bytesRead);
                    msg = new Message(Protocol.OP_DATA, chunk);
                    Protocol.writeMessage(out, msg);
                    bytesTransferred += bytesRead;
                    notifyProgress();
                }

                log("All data sent. Sending COMPLETE...");
                msg = new Message(Protocol.OP_COMPLETE, transferId.getBytes());
                Protocol.writeMessage(out, msg);

                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after COMPLETE");

                log("Transfer completed successfully!");
                if (listener != null) listener.onTransferCompleted(transferId);
                return;

            } catch (InterruptedException ex) {
                log("Transfer interrupted: " + ex.getMessage());
                if (listener != null) listener.onTransferFailed(transferId, "Interrupted");
                package core.transfer;

                import core.transfer.TransferManager.TransferListener;
                import core.utils.FileUtils;
                import core.utils.Protocol;
                import core.utils.Protocol.*;

                import core.network.ConnectionManager;

                import java.io.*;
                import java.net.Socket;
                import java.util.Arrays;

                /**
                 * Task untuk mengirim file via TCP socket dengan Protocol.java
                 * Supports resume and (optional) automatic reconnect/retry using ConnectionManager
                 */
                public class SenderTask extends TransferTask {

                    private final File file;
                    private final String transferId;
                    private final TransferListener listener;
                    private final String username;

                    // Retry behaviour
                    private final ConnectionManager connectionManager; // optional, used for reconnect
                    private final String targetIp; // target ip used to reconnect
                    private final int maxRetries;
                    private final int baseRetryDelayMs = 2000; // 2s

                    // Progress tracking
                    private long totalBytes;
                    private long bytesTransferred = 0;
                    private String remotePeerName = "Unknown";

                    // Legacy constructor (no auto-retry support)
                    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username) {
                        this(file, socket, transferId, listener, username, null, null, 0);
                    }

                    // New constructor with retry support via ConnectionManager
                    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username,
                                      ConnectionManager connectionManager, String targetIp, int maxRetries) {
                        super(socket);
                        this.file = file;
                        this.transferId = transferId;
                        this.listener = listener;
                        this.username = username;
                        this.connectionManager = connectionManager;
                        this.targetIp = targetIp;
                        this.maxRetries = Math.max(0, maxRetries);
                    }

                    public void setRemotePeerName(String name) { this.remotePeerName = name; }

                    @Override
                    public void run() {
                        int attempt = 0;

                        while (true) {
                            InputStream in = null;
                            OutputStream out = null;
                            FileInputStream fileIn = null;

                            try {
                                attempt++;
                                in = socket.getInputStream();
                                out = socket.getOutputStream();

                                try { socket.setSoTimeout(30_000); } catch (Exception ignored) {}

                                log("Starting file transfer: " + file.getName() + " to " + remotePeerName);
                                totalBytes = file.length();

                                // handshake
                                log("Sending HANDSHAKE...");
                                HandshakeMessage handshake = new HandshakeMessage(username, "1.0");
                                Message msg = new Message(Protocol.OP_HANDSHAKE, handshake.toBytes());
                                Protocol.writeMessage(out, msg);

                                // ACK
                                Message ackMsg = Protocol.readMessage(in);
                                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after HANDSHAKE");
                                log("Received ACK for HANDSHAKE");

                                // file info
                                String md5 = FileUtils.getMD5(file);
                                FileInfoMessage fileInfo = new FileInfoMessage(file.getName(), totalBytes, md5);
                                msg = new Message(Protocol.OP_FILE_INFO, fileInfo.toBytes());
                                Protocol.writeMessage(out, msg);

                                ackMsg = Protocol.readMessage(in);
                                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after FILE_INFO");
                                log("Received ACK for FILE_INFO");

                                long resumeOffset = 0;
                                try { resumeOffset = Protocol.AckMessage.fromBytes(ackMsg.payload).bytesReceived; } catch (Exception ignored) {}

                                // send data
                                fileIn = new FileInputStream(file);
                                if (resumeOffset > 0) {
                                    long skipped = skipFully(fileIn, resumeOffset);
                                    if (skipped != resumeOffset) throw new IOException("Unable to skip to resume offset: " + resumeOffset);
                                    bytesTransferred = resumeOffset;
                                    notifyProgress();
                                }

                                byte[] buffer = new byte[Protocol.BUFFER_SIZE];
                                int bytesRead;
                                log("Sending file data...");
                                while ((bytesRead = fileIn.read(buffer)) != -1) {
                                    checkPaused(); checkCancelled();
                                    byte[] chunk = Arrays.copyOf(buffer, bytesRead);
                                    msg = new Message(Protocol.OP_DATA, chunk);
                                    Protocol.writeMessage(out, msg);
                                    bytesTransferred += bytesRead;
                                    notifyProgress();
                                }

                                log("All data sent. Sending COMPLETE...");
                                msg = new Message(Protocol.OP_COMPLETE, transferId.getBytes());
                                Protocol.writeMessage(out, msg);

                                ackMsg = Protocol.readMessage(in);
                                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after COMPLETE");

                                log("Transfer completed successfully!");
                                if (listener != null) listener.onTransferCompleted(transferId);
                                return;

                            } catch (InterruptedException ex) {
                                log("Transfer interrupted: " + ex.getMessage());
                                if (listener != null) listener.onTransferFailed(transferId, "Interrupted");
                                return;

                            } catch (Exception ex) {
                                log("Error during transfer attempt " + attempt + ": " + ex.getMessage());
                                ex.printStackTrace();

                                if (connectionManager == null || targetIp == null || attempt >= maxRetries) {
                                    try { if (out != null) {
                                        ErrorMessage errorMsg = new ErrorMessage(Protocol.ErrorCode.UNKNOWN_ERROR, ex.getMessage());
                                        Message errMsg = new Message(Protocol.OP_ERROR, errorMsg.toBytes());
                                        Protocol.writeMessage(out, errMsg);
                                    }} catch (Exception ignored) {}

                                    if (listener != null) listener.onTransferFailed(transferId, ex.getMessage());
                                    return;
                                }

                                try { if (fileIn != null) { fileIn.close(); fileIn = null; } } catch (Exception ignored) {}
                                try { if (socket != null && !socket.isClosed()) socket.close(); } catch (Exception ignored) {}

                                long backoff = baseRetryDelayMs * (1L << Math.max(0, attempt - 1));
                                try { Thread.sleep(backoff); } catch (InterruptedException ie) { if (listener != null) listener.onTransferFailed(transferId, "Interrupted"); return; }

                                try {
                                    Socket newSocket = connectionManager.connectTo(targetIp);
                                    this.socket = newSocket;
                                    continue;
                                } catch (Exception reconnectEx) {
                                    log("Reconnect failed: " + reconnectEx.getMessage());
                                    if (attempt >= maxRetries) { if (listener != null) listener.onTransferFailed(transferId, "Reconnect failed: " + reconnectEx.getMessage()); return; }
                                    continue;
                                }

                            } finally {
                                try { if (fileIn != null) fileIn.close(); } catch (IOException ignored) {}
                            }
                        }
                    }

                    private long skipFully(InputStream in, long toSkip) throws IOException {
                        long remaining = toSkip;
                        while (remaining > 0) {
                            long s = in.skip(remaining);
                            if (s <= 0) {
                                int b = in.read();
                                if (b == -1) return toSkip - remaining;
                                s = 1;
                            }
                            remaining -= s;
                        }
                        return toSkip;
                    }

                    // ==================== Helper Methods ====================

                    private void notifyProgress() { if (listener != null) listener.onTransferProgress(transferId, bytesTransferred, totalBytes); }

                    private void log(String message) { System.out.println("[SenderTask] " + message); }
                }
                log("All data sent. Sending COMPLETE...");
                msg = new Message(Protocol.OP_COMPLETE, transferId.getBytes());
                Protocol.writeMessage(out, msg);

                // Step 7: Wait for final ACK
                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after COMPLETE, got " + Protocol.getOperationName(ackMsg.operation));

                log("Transfer completed successfully!");
                if (listener != null) listener.onTransferCompleted(transferId);

                return; // success

            } catch (InterruptedException e) {
                log("Transfer interrupted: " + e.getMessage());
                if (listener != null) listener.onTransferFailed(transferId, "Interrupted");
                return;

            } catch (Exception e) {
                log("Error during transfer attempt " + attempt + ": " + e.getMessage());
                e.printStackTrace();

                // if no retry config or exhausted attempts -> fail
                if (connectionManager == null || targetIp == null || attempt >= maxRetries) {
                    try { if (out != null) {
                        ErrorMessage errorMsg = new ErrorMessage(Protocol.ErrorCode.UNKNOWN_ERROR, e.getMessage());
                        Message errMsg = new Message(Protocol.OP_ERROR, errorMsg.toBytes());
                        Protocol.writeMessage(out, errMsg);
                    }} catch (Exception ignored) {}

                    if (listener != null) listener.onTransferFailed(transferId, e.getMessage());
                    return;
                }

                // otherwise attempt reconnect and retry
                log("Attempting to reconnect and resume (attempt " + attempt + ")...");
                try { if (fileIn != null) { fileIn.close(); fileIn = null; } } catch (Exception ignored) {}
                try { if (socket != null && !socket.isClosed()) socket.close(); } catch (Exception ignored) {}

                long backoff = baseRetryDelayMs * (1L << Math.max(0, attempt - 1));
                try { Thread.sleep(backoff); } catch (InterruptedException ie) { if (listener != null) listener.onTransferFailed(transferId, "Interrupted"); return; }

                try {
                    Socket newSocket = connectionManager.connectTo(targetIp);
                    this.socket = newSocket; // continue retry loop with new socket
                    continue;
                } catch (Exception reconnectEx) {
                    log("Reconnect failed: " + reconnectEx.getMessage());
                    if (attempt >= maxRetries) {
                        if (listener != null) listener.onTransferFailed(transferId, "Reconnect failed: " + reconnectEx.getMessage());
                        return;
                    }
                    // else let next loop handle the next attempt
                    continue;
                }

            } finally {
                try { if (fileIn != null) fileIn.close(); } catch (IOException ignored) {}
            }
        }
    }

    private long skipFully(InputStream in, long toSkip) throws IOException {
        long remaining = toSkip;
        while (remaining > 0) {
            long s = in.skip(remaining);
            if (s <= 0) {
                int b = in.read();
                if (b == -1) return toSkip - remaining;
                s = 1;
            }
            remaining -= s;
        }
        return toSkip;
    }

    // ==================== Helper Methods ====================

    private void notifyProgress() {
        if (listener != null) {
            listener.onTransferProgress(transferId, bytesTransferred, totalBytes);
        }
    }

    private void log(String message) {
        System.out.println("[SenderTask] " + message);
    }
}
package core.transfer;

import core.transfer.TransferManager.TransferListener;
import core.utils.FileUtils;
import core.utils.Protocol;
import core.utils.Protocol.*;

import core.network.ConnectionManager;

import java.io.*;
import java.net.Socket;
import java.util.Arrays;

/**
 * Task untuk mengirim file via TCP socket dengan Protocol.java
 * Supports resume and (optional) automatic reconnect/retry using ConnectionManager
 */
public class SenderTask extends TransferTask {

    private final File file;
    private final String transferId;
    private final TransferListener listener;
    private final String username;

    // Retry behaviour
    private final ConnectionManager connectionManager; // optional, used for reconnect
    private final String targetIp; // target ip used to reconnect
    private final int maxRetries;
    private final int baseRetryDelayMs = 2000; // 2s

    // Progress tracking
    private long totalBytes;
    private long bytesTransferred = 0;
    private String remotePeerName = "Unknown";

    // Legacy constructor (no auto-retry support)
    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username) {
        this(file, socket, transferId, listener, username, null, null, 0);
    }

    // New constructor with retry support via ConnectionManager
    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username,
                      ConnectionManager connectionManager, String targetIp, int maxRetries) {
        super(socket);
        this.file = file;
        this.transferId = transferId;
        this.listener = listener;
        this.username = username;
        this.connectionManager = connectionManager;
        this.targetIp = targetIp;
        this.maxRetries = Math.max(0, maxRetries);
    }

    public void setRemotePeerName(String name) {
        this.remotePeerName = name;
    }

    @Override
    public void run() {
        int attempt = 0;

        while (true) {
            InputStream in = null;
            OutputStream out = null;
            FileInputStream fileIn = null;

            try {
                attempt++;
                in = socket.getInputStream();
                out = socket.getOutputStream();

                // Set socket read timeout to avoid hanging forever if peer disappears
                try { socket.setSoTimeout(30_000); } catch (Exception ignored) {}

                log("Starting file transfer: " + file.getName() + " to " + remotePeerName);
                totalBytes = file.length();

                // Step 1: Send HANDSHAKE
                log("Sending HANDSHAKE...");
                HandshakeMessage handshake = new HandshakeMessage(username, "1.0");
                Message msg = new Message(Protocol.OP_HANDSHAKE, handshake.toBytes());
                Protocol.writeMessage(out, msg);

                // Step 2: Wait for ACK
                Message ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) {
                    throw new IOException("Expected ACK after HANDSHAKE, got " + Protocol.getOperationName(ackMsg.operation));
                }
                log("Received ACK for HANDSHAKE");

                // Step 3: Send FILE_INFO
                log("Sending FILE_INFO: " + file.getName() + " (" + FileUtils.formatFileSize(totalBytes) + ")");
                String md5 = FileUtils.getMD5(file);
                FileInfoMessage fileInfo = new FileInfoMessage(file.getName(), totalBytes, md5);
                msg = new Message(Protocol.OP_FILE_INFO, fileInfo.toBytes());
                Protocol.writeMessage(out, msg);

                // Step 4: Wait for ACK (receiver may include already-received offset for resume)
                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) {
                    throw new IOException("Expected ACK after FILE_INFO, got " + Protocol.getOperationName(ackMsg.operation));
                }
                log("Received ACK for FILE_INFO");

                long resumeOffset = 0;
                try { resumeOffset = Protocol.AckMessage.fromBytes(ackMsg.payload).bytesReceived; } catch (Exception ignored) {}

                // Step 5: Send FILE DATA in chunks
                fileIn = new FileInputStream(file);

                // If resumeOffset > 0 skip those bytes
                if (resumeOffset > 0) {
                    log("Resuming transfer from offset: " + resumeOffset);
                    long skipped = skipFully(fileIn, resumeOffset);
                    if (skipped != resumeOffset) throw new IOException("Unable to skip to resume offset: " + resumeOffset);
                    bytesTransferred = resumeOffset;
                    notifyProgress();
                }

                byte[] buffer = new byte[Protocol.BUFFER_SIZE];
                int bytesRead;
                log("Sending file data...");
                while ((bytesRead = fileIn.read(buffer)) != -1) {
                    checkPaused(); checkCancelled();

                    byte[] chunk = Arrays.copyOf(buffer, bytesRead);
                    msg = new Message(Protocol.OP_DATA, chunk);
                    Protocol.writeMessage(out, msg);

                    bytesTransferred += bytesRead;
                    notifyProgress();
                }

                // Step 6: Send COMPLETE
                log("All data sent. Sending COMPLETE...");
                msg = new Message(Protocol.OP_COMPLETE, transferId.getBytes());
                Protocol.writeMessage(out, msg);

                // Step 7: Wait for final ACK
                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) throw new IOException("Expected ACK after COMPLETE, got " + Protocol.getOperationName(ackMsg.operation));

                log("Transfer completed successfully!");
                if (listener != null) listener.onTransferCompleted(transferId);

                return; // success

            } catch (InterruptedException e) {
                log("Transfer interrupted: " + e.getMessage());
                if (listener != null) listener.onTransferFailed(transferId, "Interrupted");
                return;

            } catch (Exception e) {
                log("Error during transfer attempt " + attempt + ": " + e.getMessage());
                e.printStackTrace();

                // if no retry config or exhausted attempts -> fail
                if (connectionManager == null || targetIp == null || attempt >= maxRetries) {
                    try { if (out != null) {
                        ErrorMessage errorMsg = new ErrorMessage(Protocol.ErrorCode.UNKNOWN_ERROR, e.getMessage());
                        Message errMsg = new Message(Protocol.OP_ERROR, errorMsg.toBytes());
                        Protocol.writeMessage(out, errMsg);
                    }} catch (Exception ignored) {}

                    if (listener != null) listener.onTransferFailed(transferId, e.getMessage());
                    return;
                }

                // otherwise attempt reconnect and retry
                log("Attempting to reconnect and resume (attempt " + attempt + ")...");
                try { if (fileIn != null) { fileIn.close(); fileIn = null; } } catch (Exception ignored) {}
                try { if (socket != null && !socket.isClosed()) socket.close(); } catch (Exception ignored) {}

                long backoff = baseRetryDelayMs * (1L << Math.max(0, attempt - 1));
                try { Thread.sleep(backoff); } catch (InterruptedException ie) { if (listener != null) listener.onTransferFailed(transferId, "Interrupted"); return; }

                try {
                    Socket newSocket = connectionManager.connectTo(targetIp);
                    this.socket = newSocket; // continue retry loop with new socket
                    continue;
                } catch (Exception reconnectEx) {
                    log("Reconnect failed: " + reconnectEx.getMessage());
                    if (attempt >= maxRetries) {
                        if (listener != null) listener.onTransferFailed(transferId, "Reconnect failed: " + reconnectEx.getMessage());
                        return;
                    }
                    // else let next loop handle the next attempt
                    continue;
                }

            } finally {
                try { if (fileIn != null) fileIn.close(); } catch (IOException ignored) {}
            }
        }
    }

    private long skipFully(InputStream in, long toSkip) throws IOException {
        long remaining = toSkip;
        while (remaining > 0) {
            long s = in.skip(remaining);
            if (s <= 0) {
                int b = in.read();
                if (b == -1) return toSkip - remaining;
                s = 1;
            }
            remaining -= s;
        }
        return toSkip;
    }

    // ==================== Helper Methods ====================

    private void notifyProgress() {
        if (listener != null) {
            listener.onTransferProgress(transferId, bytesTransferred, totalBytes);
        }
    }

    private void log(String message) {
        System.out.println("[SenderTask] " + message);
    }
}
package core.transfer;

import core.transfer.TransferManager.TransferListener;
import core.utils.FileUtils;
import core.utils.Protocol;
import core.utils.Protocol.*;

import java.io.*;
import java.net.Socket;
import core.network.ConnectionManager;
import java.util.Arrays;

/**
 * Task untuk mengirim file via TCP socket dengan Protocol.java
 * 
 * Protocol Flow:
 * 1. Send HANDSHAKE (username|version)
 * 2. Wait ACK
 * 3. Send FILE_INFO (filename|filesize|md5)
 * 4. Wait ACK
 * 5. Send DATA chunks (8KB)
 * 6. Send COMPLETE
 * 7. Wait ACK
 */
public class SenderTask extends TransferTask {

    private final File file;
    private final String transferId;
    private final TransferListener listener;
    private final String username;

    // Retry behaviour
    private final ConnectionManager connectionManager; // optional, used for reconnect
    private final String targetIp; // target ip used to reconnect
    private final int maxRetries;
    private final int baseRetryDelayMs = 2000; // 2s

    // Progress tracking
    private long totalBytes;
    private long bytesTransferred = 0;
    private String remotePeerName = "Unknown";

    // Legacy constructor (no auto-retry support)
    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username) {
        this(file, socket, transferId, listener, username, null, null, 0);
    }

    // New constructor with retry support via ConnectionManager
    public SenderTask(File file, Socket socket, String transferId, TransferListener listener, String username,
                      ConnectionManager connectionManager, String targetIp, int maxRetries) {
        super(socket);
        this.file = file;
        this.transferId = transferId;
        this.listener = listener;
        this.username = username;
        this.connectionManager = connectionManager;
        this.targetIp = targetIp;
        this.maxRetries = Math.max(0, maxRetries);
    }

    public void setRemotePeerName(String name) {
        this.remotePeerName = name;
    }

    @Override
    public void run() {
        int attempt = 0;

        while (true) {
            InputStream in = null;
            OutputStream out = null;
            FileInputStream fileIn = null;

            try {
                attempt++;
                in = socket.getInputStream();
                out = socket.getOutputStream();

                // Set socket read timeout to avoid hanging forever if peer disappears
                try {
                    socket.setSoTimeout(30_000); // 30 seconds
                } catch (Exception ignored) { }

                log("Starting file transfer: " + file.getName() + " to " + remotePeerName);
                totalBytes = file.length();

                // Step 1: Send HANDSHAKE
                log("Sending HANDSHAKE...");
                HandshakeMessage handshake = new HandshakeMessage(username, "1.0");
                Message msg = new Message(Protocol.OP_HANDSHAKE, handshake.toBytes());
                Protocol.writeMessage(out, msg);

                // Step 2: Wait for ACK
                Message ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) {
                    throw new IOException("Expected ACK after HANDSHAKE, got " +
                            Protocol.getOperationName(ackMsg.operation));
                }
                log("Received ACK for HANDSHAKE");

                // Step 3: Send FILE_INFO
                log("Sending FILE_INFO: " + file.getName() + " (" +
                        FileUtils.formatFileSize(totalBytes) + ")");
                String md5 = FileUtils.getMD5(file);
                FileInfoMessage fileInfo = new FileInfoMessage(file.getName(), totalBytes, md5);
                msg = new Message(Protocol.OP_FILE_INFO, fileInfo.toBytes());
                Protocol.writeMessage(out, msg);

                // Step 4: Wait for ACK
                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) {
                    throw new IOException("Expected ACK after FILE_INFO, got " +
                            Protocol.getOperationName(ackMsg.operation));
                }
                log("Received ACK for FILE_INFO");

                // Check if receiver indicated it already has some bytes (resume)
                long resumeOffset = 0;
                try {
                    Protocol.AckMessage ackInfo = Protocol.AckMessage.fromBytes(ackMsg.payload);
                    resumeOffset = ackInfo.bytesReceived;
                } catch (Exception ignored) {
                    // Not an AckMessage payload (old clients) -> assume 0
                }

                // Step 5: Send FILE DATA in chunks
                fileIn = new FileInputStream(file);

                // If resumeOffset > 0 skip those bytes
                if (resumeOffset > 0) {
                    log("Resuming transfer from offset: " + resumeOffset);
                    long skipped = skipFully(fileIn, resumeOffset);
                    if (skipped != resumeOffset) {
                        throw new IOException("Unable to skip to resume offset: " + resumeOffset);
                    }
                    bytesTransferred = resumeOffset;
                    notifyProgress();
                }
                byte[] buffer = new byte[Protocol.BUFFER_SIZE];
                int bytesRead;

                log("Sending file data...");
                while ((bytesRead = fileIn.read(buffer)) != -1) {
                    // Check pause/cancel
                    checkPaused();
                    checkCancelled();

                    // Send data chunk
                    byte[] chunk = Arrays.copyOf(buffer, bytesRead);
                    msg = new Message(Protocol.OP_DATA, chunk);
                    Protocol.writeMessage(out, msg);

                    // Update progress
                    bytesTransferred += bytesRead;
                    notifyProgress();
                }

                log("All data sent. Sending COMPLETE...");

                // Step 6: Send COMPLETE
                msg = new Message(Protocol.OP_COMPLETE, transferId.getBytes());
                Protocol.writeMessage(out, msg);

                // Step 7: Wait for final ACK
                ackMsg = Protocol.readMessage(in);
                if (ackMsg.operation != Protocol.OP_ACK) {
                    throw new IOException("Expected ACK after COMPLETE, got " +
                            Protocol.getOperationName(ackMsg.operation));
                }

                log("Transfer completed successfully!");
                if (listener != null) {
                    listener.onTransferCompleted(transferId);
                }

                // success, exit
                return;

            } catch (InterruptedException e) {
                log("Transfer interrupted: " + e.getMessage());
                if (listener != null) {
                    listener.onTransferFailed(transferId, "Interrupted");
                }
                return;

            } catch (Exception e) {
                log("Error during transfer attempt " + attempt + ": " + e.getMessage());
                e.printStackTrace();

                // If retry not possible, or no more attempts, report failure
                if (connectionManager == null || targetIp == null || attempt >= maxRetries) {
                    try {
                        if (out != null) {
                            ErrorMessage errorMsg = new ErrorMessage(
                                    Protocol.ErrorCode.UNKNOWN_ERROR,
                                    e.getMessage());
                            Message errMsg = new Message(Protocol.OP_ERROR, errorMsg.toBytes());
                            Protocol.writeMessage(out, errMsg);
                        }
                    } catch (Exception ignored) { }

                    if (listener != null) {
                        listener.onTransferFailed(transferId, e.getMessage());
                    }

                    return;
                }

                // attempt reconnect + retry
                log("Attempting to reconnect and resume (attempt " + attempt + ")...");

                // cleanup and try to reconnect
                try { if (fileIn != null) { fileIn.close(); fileIn = null; } } catch (Exception ignored) {}
                try { if (socket != null && !socket.isClosed()) { try { socket.close(); } catch (IOException ignored) {} } } catch (Exception ignored) {}

                long backoff = baseRetryDelayMs * (1L << (Math.max(0, attempt - 1)));
                try { Thread.sleep(backoff); } catch (InterruptedException ie) { if (listener != null) listener.onTransferFailed(transferId, "Interrupted"); return; }

                try {
                    Socket newSocket = connectionManager.connectTo(targetIp);
                    this.socket = newSocket;
                    // continue to retry loop
                    continue;
                } catch (Exception reconnectEx) {
                    log("Reconnect failed: " + reconnectEx.getMessage());
                    if (attempt >= maxRetries) {
                        if (listener != null) listener.onTransferFailed(transferId, "Reconnect failed: " + reconnectEx.getMessage());
                        return;
                    }
                    // else allow next loop iteration to retry
                    continue;
                }

            } finally {
                // ensure file resource is closed for this attempt; socket is managed for retry
                try { if (fileIn != null) fileIn.close(); } catch (IOException ignored) {}
            }
        }
        } catch (InterruptedException e) {
            log("Transfer interrupted: " + e.getMessage());
            if (listener != null) {
                listener.onTransferFailed(transferId, "Interrupted");
            }
        } catch (Exception e) {
            log("Error during transfer: " + e.getMessage());
            e.printStackTrace();

            // Try to send error message
            try {
                    if (listener != null) {
                        listener.onTransferCompleted(transferId);
                    }

                    // success, break out of retry loop
                    return;

                } catch (InterruptedException e) {
                    Protocol.writeMessage(out, errMsg);
                }
            } catch (Exception ignored) {
            }
                    return;
                } catch (Exception e) {
                    lastEx = e;
                    log("Error during transfer attempt " + attempt + ": " + e.getMessage());
                    e.printStackTrace();

                    // If no retry config available, fail immediately
                    if (connectionManager == null || targetIp == null || maxRetries <= 0 || attempt > maxRetries) {
                        // Try to send error message
                        try {
                            if (socket != null && !socket.isClosed()) {
                                out = socket.getOutputStream();
                                ErrorMessage errorMsg = new ErrorMessage(
                                        Protocol.ErrorCode.UNKNOWN_ERROR,
                                        e.getMessage());
                                Message errMsg = new Message(Protocol.OP_ERROR, errorMsg.toBytes());
                                Protocol.writeMessage(out, errMsg);
                            }
                        } catch (Exception ignored) { }

                        if (listener != null) {
                            listener.onTransferFailed(transferId, e.getMessage());
                        }

                        // cleanup and exit
                        break;
                    }

                    // attempt reconnect + retry
                    log("Attempting to reconnect and resume (attempt " + attempt + ")...");

                    try {
                        // cleanup current socket resources
                        if (fileIn != null) { fileIn.close(); fileIn = null; }
                        if (socket != null && !socket.isClosed()) { try { socket.close(); } catch (IOException ignored) {} }

                        // backoff
                        long backoff = baseRetryDelayMs * (1L << (attempt - 1));
                        Thread.sleep(backoff);

                        // try to reconnect
                        Socket newSocket = connectionManager.connectTo(targetIp);
                        this.socket = newSocket; // TransferTask.socket

                        // continue loop to retry
                        continue;
                    } catch (Exception reconnectEx) {
                        log("Reconnect failed: " + reconnectEx.getMessage());
                        // If we've exhausted retries, fail
                        if (attempt >= maxRetries) {
                            if (listener != null) listener.onTransferFailed(transferId, "Reconnect failed: " + reconnectEx.getMessage());
                            break;
                        }

                        // else proceed to next attempt (after loop's continue)
                        continue;
                    }
            }
        } finally {
            // Cleanup
            try {
                if (fileIn != null)
                    // Do not close socket here - if reconnecting we'll reuse/replace it
                    // If transfer finished or gave up, close socket
                    if ((connectionManager == null || attempt > maxRetries) && socket != null && !socket.isClosed())
                        socket.close();
                    socket.close();
            } catch (IOException ignored) {
            }

                // if we reach here we either succeeded above (returned) or broke due to failure
                break;
        }
    }

    private long skipFully(InputStream in, long toSkip) throws IOException {
        long remaining = toSkip;
        while (remaining > 0) {
            long s = in.skip(remaining);
            if (s <= 0) {
                // try to read and discard instead
                int b = in.read();
                if (b == -1) return toSkip - remaining;
                s = 1;
            }
            remaining -= s;
        }
        return toSkip;
    }

    // ==================== Helper Methods ====================

    private void notifyProgress() {
        if (listener != null) {
            listener.onTransferProgress(transferId, bytesTransferred, totalBytes);
        }
    }

    private void log(String message) {
        System.out.println("[SenderTask] " + message);
    }
}